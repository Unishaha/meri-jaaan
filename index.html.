function playRPS(){
 let a=document.getElementById("r1").value,b=document.getElementById("r2").value;
 let result=a===b?"It's a draw!":({Rock:"Scissors",Paper:"Rock",Scissors:"Paper"}[a]===b?"Player 1 wins!":"Player 2 wins!");
 if(result.includes("Player 1"))rpsScores[0]++;
 if(result.includes("Player 2"))rpsScores[1]++;
 document.getElementById("rpsResult").textContent=`${a} vs ${b} — ${result}`;
}
function resetScores(){scores=[0,0];memScores=[0,0];qscore=[0,0];rpsScores=[0,0];render()}

// AMBIENT SOUND: browser generated, sustained, non-melodic
async function toggleMusic(){
 try{
  if(musicOn){
   await musicContext.suspend();musicOn=false;
   document.getElementById("soundButton").textContent="♫ Enable background sound";
   return;
  }
  const AC=window.AudioContext||window.webkitAudioContext;
  if(!AC){alert("Audio is not supported by this browser.");return}
  if(!musicContext){
   musicContext=new AC();
   musicGain=musicContext.createGain();
   musicGain.gain.value=.10;
   musicGain.connect(musicContext.destination);
   [65.4,98,130.8].forEach((freq,i)=>{
    let osc=musicContext.createOscillator();
    let gain=musicContext.createGain();
    let filter=musicContext.createBiquadFilter();
    osc.type="sine";
    osc.frequency.value=freq;
    filter.type="lowpass";filter.frequency.value=350;
    gain.gain.value=[.35,.10,.045][i];
    osc.connect(filter);filter.connect(gain);gain.connect(musicGain);
    osc.start();
   });
   let noiseBuffer=musicContext.createBuffer(1,musicContext.sampleRate*2,musicContext.sampleRate);
   let data=noiseBuffer.getChannelData(0);
   for(let i=0;i<data.length;i++)data[i]=Math.random()*2-1;
   let noise=musicContext.createBufferSource();
   let ng=musicContext.createGain();
   let nf=musicContext.createBiquadFilter();
   noise.buffer=noiseBuffer;noise.loop=true;
   nf.type="lowpass";nf.frequency.value=220;
   ng.gain.value=.012;
   noise.connect(nf);nf.connect(ng);ng.connect(musicGain);noise.start();
  }
  await musicContext.resume();musicOn=true;
  document.getElementById("soundButton").textContent="♫ Pause background sound";
 }catch(e){console.log(e)}
}

// FIREWORKS
const canvas=document.getElementById("fireworks");
const ctx=canvas.getContext("2d");
let particles=[];
function resize(){canvas.width=innerWidth;canvas.height=innerHeight}
resize();addEventListener("resize",resize);
function burst(x,y){
 for(let i=0;i<65;i++){
  let a=Math.random()*Math.PI*2,s=1+Math.random()*5;
  particles.push({x,y,vx:Math.cos(a)*s,vy:Math.sin(a)*s,life:80,color:`hsl(${Math.random()*360},90%,70%)`});
 }
}
function animateFireworks(){
 ctx.clearRect(0,0,canvas.width,canvas.height);
 particles=particles.filter(p=>p.life>0);
 particles.forEach(p=>{
  p.x+=p.vx;p.y+=p.vy;p.vy+=.035;p.life--;
  ctx.globalAlpha=p.life/80;ctx.fillStyle=p.color;
  ctx.beginPath();ctx.arc(p.x,p.y,3,0,Math.PI*2);ctx.fill();
 });
 ctx.globalAlpha=1;
 requestAnimationFrame(animateFireworks);
}
animateFireworks();
function celebrate(){
 for(let i=0;i<5;i++)setTimeout(()=>burst(Math.random()*canvas.width,Math.random()*canvas.height*.65),i*250);
 confetti();
}
function confetti(){
 for(let i=0;i<70;i++){
  let e=document.createElement("span");
  e.className="heart";e.textContent=["✦","♡","❀","✧"][i%4];
  e.style.left=Math.random()*100+"vw";
  e.style.animationDuration=(3+Math.random()*5)+"s";
  document.getElementById("particles").appendChild(e);
  setTimeout(()=>e.remove(),9000);
 }
}

