 <div style="margin-top:20px">
 <button class="btn primary" onclick="randomWish()">Give me another wish 🌷</button>
 <button class="btn" onclick="surprise()">Open a surprise 🎁</button>
 <p id="result" class="output"></p>
 </div>`;

 if(current===0) html=`
 <h2>Welcome to your little world 💗</h2>
 <p>This is a birthday collection made with wishes, games, surprises and happy thoughts.</p>
 <p>Explore the 100 sections from the left menu. There is something special waiting on every page.</p>
 <button class="btn primary" onclick="go(10)">Open birthday letter 💌</button>
 <button class="btn" onclick="celebrate()">Start the celebration 🎆</button>`;

 if(current===10) html=`
 <h2>A letter for you 💌</h2>
 <div class="letter">${letter}</div>
 <button class="btn primary" onclick="window.print()">Print / Save letter</button>`;

 if(current===39) html=tttHTML();
 if(current===40) html=memoryHTML();
 if(current===41) html=quizHTML();
 if(current===42) html=rpsHTML();
 if(current===43) html=`
 <h2>Two-player scoreboard 🏆</h2>
 <p>Player 1: ${scores[0]} wins</p>
 <p>Player 2: ${scores[1]} wins</p>
 <p>Memory Player 1: ${memScores[0]} pairs</p>
 <p>Memory Player 2: ${memScores[1]} pairs</p>
 <button class="btn" onclick="resetScores()">Reset scores</button>`;

 if([34,35,36,37,38,91,92].includes(current)) html=`
 <h2>Let the celebration begin! 🎆</h2>
 <p>Make this moment sparkle with animated fireworks and confetti.</p>
 <button class="btn primary" onclick="celebrate()">Launch fireworks</button>
 <button class="btn" onclick="confetti()">Release confetti</button>`;

 if([44,45,46].includes(current)) html=`
 <h2>Ambient sound lounge ♫</h2>
 <p>A continuous atmospheric soundscape generated directly by your browser. It uses soft sustained sound and gentle filtered noise, not a tune or melody.</p>
 <button class="btn primary" onclick="toggleMusic()">Play / Pause sound</button>
 <p class="output">${musicOn?"Ambient sound is playing":"Sound is paused"}</p>
 <p>If your browser blocks autoplay, press the sound button at the top.</p>`;

 if(current===48) html=`
 <h2>Make a birthday wish 🌟</h2>
 <input id="wishInput" class="field" placeholder="Write your birthday wish">
 <button class="btn primary" onclick="saveWish()">Save my wish</button>
 <p id="result" class="output"></p>`;

 if([29,30,31,32,47,49,50,51,55,56,57,58,59,70,71,72,73,77,78,79,80,81,82,83,84,85,86,87,88,89,93,94,95,96,97,98,99].includes(current)) html=`
 <h2>${names[current]} ✨</h2>
 <p>${wishes[current%wishes.length]}</p>
 <textarea id="note" class="field" rows="4" placeholder="Write something special here..."></textarea><br>
 <button class="btn primary" onclick="saveNote()">Save note</button>
 <button class="btn" onclick="surprise()">Reveal surprise</button>
 <p id="result" class="output"></p>`;

 if(current===52) html=`
 <h2>How are you feeling? 🌸</h2>
 <select id="mood" class="field">
 <option>Happy 😊</option><option>Calm 🌿</option>
 <option>Excited ✨</option><option>Thoughtful 💭</option>
 <option>Relaxed 🌙</option>
 </select>
 <button class="btn primary" onclick="showMood()">Save mood</button>
 <p id="result" class="output"></p>`;

 if(current===74) html=`
 <h2>Birthday countdown ⏳</h2>
 <p>Get ready for a little celebration.</p>
 <button class="btn primary" onclick="countdown()">Start countdown</button>
 <h2 id="timer">🎂</h2>`;

 if(current===75) html=`
 <h2>Celebration checklist 🎀</h2>
 ${["Enjoy your favourite treat","Listen to favourite music","Make a birthday wish","Take a lovely break","Share a laugh","Enjoy the little moments"].map(x=>`<p><label><input type="checkbox"> ${x}</label></p>`).join("")}`;

 if(current===76) html=`
 <h2>Party planner 🎉</h2>
 <input class="field" id="party" placeholder="Celebration idea"><br>
 <input class="field" id="treat" placeholder="Favourite treat"><br>
 <button class="btn primary" onclick="planParty()">Save plan</button>
 <p id="result"></p>`;

 content.innerHTML=html;
}

function randomWish(){
 let el=document.getElementById("result");
 if(el)el.textContent=wishes[Math.floor(Math.random()*wishes.length)];
}
