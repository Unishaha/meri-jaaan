// TWO PLAYER TIC TAC TOE
function tttHTML(){
 let w=winner(board);
 return `<h2>Tic Tac Toe ❌⭕</h2>
 <p>Player 1 is X. Player 2 is O.</p>
 <h3>${w?`Player ${w==="X"?1:2} wins!`:board.every(Boolean)?"It's a draw!":`Player ${turn==="X"?1:2}'s turn`}</h3>
 <div class="board">${board.map((v,i)=>`<button class="cell" onclick="playCell(${i})">${v}</button>`).join("")}</div>
 <p>Player 1: ${scores[0]} | Player 2: ${scores[1]}</p>
 <button class="btn primary" onclick="resetTTT()">New round</button>`;
}
function winner(b){
 for(let [a,c,d] of [[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]])
 if(b[a]&&b[a]===b[c]&&b[a]===b[d])return b[a];
 return null;
}
function playCell(i){
 if(board[i]||winner(board)||board.every(Boolean))return;
 board[i]=turn;
 let w=winner(board);
 if(w)scores[w==="X"?0:1]++;
 else turn=turn==="X"?"O":"X";
 render();
}
function resetTTT(){board=Array(9).fill("");turn="X";render()}

// TWO PLAYER MEMORY MATCH
function resetMem(){
 let a=["🌸","⭐","🎂","💗","🎁","🦋","🌙","✨"];
 mem=[...a,...a].sort(()=>Math.random()-.5).map(v=>({v,open:false,done:false}));
 selected=[];memPlayer=0;memScores=[0,0];memBusy=false;
}
function memoryHTML(){
 if(!mem.length)resetMem();
 return `<h2>Memory Match 🧠</h2>
 <p>Player ${memPlayer+1}'s turn. Find two matching cards.</p>
 <div class="memory">${mem.map((v,i)=>`<button class="mem" onclick="flip(${i})">${v.open||v.done?v.v:"?"}</button>`).join("")}</div>
 <p>Player 1: ${memScores[0]} | Player 2: ${memScores[1]}</p>
 <button class="btn primary" onclick="resetMem();render()">Reset game</button>`;
}
function flip(i){
 if(memBusy||mem[i].done||mem[i].open)return;
 mem[i].open=true;selected.push(i);
 if(selected.length===2){
  memBusy=true;
  let [a,b]=selected;
  if(mem[a].v===mem[b].v){
   mem[a].done=mem[b].done=true;
   memScores[memPlayer]++;
   selected=[];memBusy=false;
  }else{
   setTimeout(()=>{
    mem[a].open=mem[b].open=false;
    selected=[];memPlayer=1-memPlayer;memBusy=false;
    if(current===40)render();
   },850);
  }
 }
 render();
}

// TWO PLAYER QUIZ
const questions=[
 ["Which planet is called the Red Planet?","mars"],
 ["How many days are in a leap year?","366"],
 ["Which is the largest ocean?","pacific"],
 ["What is the closest star to Earth?","sun"],
 ["How many sides does a hexagon have?","6"],
 ["What is the opposite of north?","south"]
];
let qi=0,qscore=[0,0];
function quizHTML(){
 return `<h2>Two Player Quiz 🧩</h2>
 <p>Player ${qi%2+1}: ${questions[qi%questions.length][0]}</p>
 <input class="field" id="answer" placeholder="Your answer">
 <button class="btn primary" onclick="answerQuiz()">Submit answer</button>
 <p>Player 1: ${qscore[0]} | Player 2: ${qscore[1]}</p>
 <p id="quizResult"></p>
 <button class="btn" onclick="qi=0;qscore=[0,0];render()">Reset quiz</button>`;
}
function answerQuiz(){
 let a=document.getElementById("answer").value.trim().toLowerCase();
 let correct=questions[qi%questions.length][1];
 let player=qi%2;
 if(a===correct)qscore[player]++;
 document.getElementById("quizResult").textContent=a===correct?"Correct! 🎉":"The answer was "+correct;
 qi++;
 setTimeout(()=>{if(current===41)render()},1100);
}

// TWO PLAYER ROCK PAPER SCISSORS
let rps=["Rock","Paper","Scissors"];
function rpsHTML(){
 return `<h2>Rock Paper Scissors ✊</h2>
 <p>Both players select their choice and reveal the result.</p>
 <p>Player 1</p><select id="r1" class="field">${rps.map(x=>`<option>${x}</option>`)}</select>
 <p>Player 2</p><select id="r2" class="field">${rps.map(x=>`<option>${x}</option>`)}</select><br>
